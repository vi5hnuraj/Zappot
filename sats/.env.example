# Copy to .env and fill in. .env is git-ignored: never commit it.

# --- Lightning (required for real payments) ---------------------------------
# A Nostr Wallet Connect connection string from your wallet
# (Alby Hub, Coinos, Phoenix, Mutiny, LNbits...). Format:
#   nostr+walletconnect://<wallet-pubkey>?relay=wss%3A%2F%2F...&secret=<hex>
# The wallet must allow make_invoice, pay_invoice and lookup_invoice.
NWC_URI=

# --- Nostr ------------------------------------------------------------------
# Coordinator identity used to sign circle announcements. If unset, one is
# generated on first run and saved to data/identity.json.
NOSTR_NSEC=
# Comma-separated relay list for circle announcements.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# --- AI coordinator (optional) ----------------------------------------------
# Without a key the coordinator falls back to deterministic FR/EN/WO templates
# and a rule-based reliability score. Nothing else in the app depends on it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
OPENAI_MODEL=gpt-4o-mini

# --- Server -----------------------------------------------------------------
PORT=8788
# Public base URL used when building invite links.
PUBLIC_URL=http://localhost:8788
DATA_DIR=data
